{
  "manifest_version": 3,
  "name": "Gojobs",
  "version": "0.1.0",
  "description": "Monitors job boards and repos, autofills applications.",
  "permissions": [],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "github_monitor.js"
      ]
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "form_scanner.js",
        "classify.js",
        "autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
